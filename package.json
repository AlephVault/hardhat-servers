{
  "name": "hardhat-servers",
  "version": "3.0.0",
  "description": "A Hardhat plugin that provides tasks to launch IPFS and/or HTTP servers in an in-project local directory",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "build": "node --check src/index.js && node --check src/tasks/http.js && node --check src/tasks/ipfs.js",
    "test": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/AlephVault/hardhat-servers.git"
  },
  "keywords": [
    "hardhat",
    "plugin",
    "servers"
  ],
  "author": "Luis Masuelli",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AlephVault/hardhat-servers/issues"
  },
  "homepage": "https://github.com/AlephVault/hardhat-servers#readme",
  "peerDependencies": {
    "hardhat": "^3.0.0",
    "hardhat-enquirer-plus": "^3.0.0"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "finalhandler": "^1.2.0",
    "ipfs": "^0.66.1",
    "ipfs-http-gateway": "^0.13.1",
    "ipfs-http-server": "^0.15.1",
    "serve-static": "^1.15.0"
  }
}
